# LLM Provider (choose one)
# OpenAI
OPENAI_API_KEY=sk-...
# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Search API (choose one)
# Tavily (recommended for AI-focused search)
TAVILY_API_KEY=tvly-...
# SerpAPI
SERPAPI_KEY=...
# Brave Search
BRAVE_API_KEY=...

# Export Services (optional)
# Google Docs API - path to service account credentials JSON
GOOGLE_CREDENTIALS_PATH=./credentials/google-service-account.json
# Notion API
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=...

# Application Settings
LOG_LEVEL=INFO
MAX_ITERATIONS=3
RELEVANCE_THRESHOLD=0.6
